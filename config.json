  "hunt": {
    "_comment_serve": "serve_port > 0 이면 리포트를 http://127.0.0.1:PORT 로 서빙합니다 (CORS 문제 해소). 0 이면 file:// 직접 열기.",
    "serve_port": 18080,

    "services": {
      "_comment": "enabled: false 로 설정하면 해당 서비스를 Hunt 탭에서 숨깁니다. url 을 프록시/미러로 교체 가능.",
      "mb": {
