      },
      "uh_url": {
        "enabled": true,
        "label": "URLhaus (URL)",
        "url": "https://urlhaus-api.abuse.ch/v1/url/"
      },
      "uh_host": {
        "enabled": true,
        "label": "URLhaus (Host)",
        "url": "https://urlhaus-api.abuse.ch/v1/host/"
      },
      "feodo": {
        "enabled": true,
        "label": "Feodo Tracker",
        "url": "https://feodotracker.abuse.ch/api/v1/host_info/"
      }
